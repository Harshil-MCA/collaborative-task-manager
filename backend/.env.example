PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/collaborative_task_manager
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Optional values used only by createManager.js
MANAGER_NAME=Example Manager
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace-with-a-local-password

# Optional values used only by seed.js
SEED_MANAGER_NAME=Example Manager
SEED_MANAGER_EMAIL=seed-manager@example.com
SEED_MANAGER_PASSWORD=replace-with-a-local-password
SEED_USER_NAME=Example User
SEED_USER_EMAIL=seed-user@example.com
SEED_USER_PASSWORD=replace-with-a-local-password

# Optional advanced-role accounts; omit a group when it is not needed
SEED_PROJECT_MANAGER_NAME=Example Project Manager
SEED_PROJECT_MANAGER_EMAIL=seed-pm@example.com
SEED_PROJECT_MANAGER_PASSWORD=replace-with-a-local-password
SEED_DEVELOPER_NAME=Example Developer
SEED_DEVELOPER_EMAIL=seed-developer@example.com
SEED_DEVELOPER_PASSWORD=replace-with-a-local-password
SEED_QA_NAME=Example QA
SEED_QA_EMAIL=seed-qa@example.com
SEED_QA_PASSWORD=replace-with-a-local-password
